<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.NFC" />
  <!-- Only to read a website's asset links, to check that an app asking for its passkeys is its own. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <uses-feature
    android:name="android.hardware.nfc"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.usb.host"
    android:required="false" />

  <application
    android:name=".PasskeyApp"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Passkey">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
      android:name=".PasskeyActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:launchMode="singleTop"
      android:theme="@style/Theme.Passkey.Translucent" />

    <service
      android:name=".PasskeyProviderService"
      android:enabled="true"
      android:exported="true"
      android:icon="@drawable/ic_security_key_24dp"
      android:label="@string/service_label"
      android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
      <intent-filter>
        <action android:name="android.service.credentials.CredentialProviderService" />
      </intent-filter>
      <meta-data
        android:name="android.credentials.provider"
        android:resource="@xml/provider" />
    </service>

  </application>

</manifest>
