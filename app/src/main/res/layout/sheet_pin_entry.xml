<!--
  The security key's PIN, as a field in a block of its own: the same field the Password Store fork
  asks a card's PIN with, less the option to keep it until the screen goes off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="?attr/dialogPreferredPadding"
  android:paddingVertical="@dimen/activity_horizontal_margin">

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/pin_field"
    style="@style/Widget.APS.ListField"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/pin_hint"
    app:endIconMode="password_toggle"
    app:hintEnabled="true">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/pin_edit_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:imeOptions="actionDone|flagNoPersonalizedLearning"
      android:importantForAutofill="no"
      android:inputType="textPassword" />

    <requestFocus />
  </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
